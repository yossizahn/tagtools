{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by tag-lsp grammar (taglsp/vscode/build.ps1). Do not edit.",
  "name": "Tag script",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#number"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(CONTINUE|DOWNTO|RETURN|BREAK|WHILE|ELSE|GOTO|THEN|END|FOR|DO|IF|TO)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "keyword.control.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(BEFORE|AFTER|START|ADDR|LIST|AND|DIV|MOD|NOT|IN|OF|OR)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "keyword.operator.word.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(true|false)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "constant.language.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(CHARS|WORDS|LINES|PARAS|PAGES|LAST|THIS|CHAR|WORD|LINE|PARA|PAGE)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "support.variable.unit.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(BOOLEAN|INTEGER|POINTER|STRING|SELECT|BYTE|REAL|INT)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "storage.type.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])const(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "keyword.other.const.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(GetSystemMetrics|GetRegistration|GetNoteModulus|GetFileString|SetFileString|ObjectChanged|GetPasteInfo|GetStyleName|BreakPenalty|SetDlgScript|GetWindowPos|GetKeyValue|GetTagIndex|GetTagTable|GetFileName|SetDlgFocus|GetDlgFocus|FindOptions|SetDlgText|GetDlgText|ActiveText|GetVarName|ReplaceTag|SetPenalty|ActivePage|GetViewSel|StartLine|LineCount|StartPara|FindBreak|tightness|DlgEnable|GetTagDir|FillArray|CopyArray|NextLine|PrevPage|NextPage|FindPage|NumToHeb|ModalDlg|SetCheck|GetCheck|IsGlobal|rFindTag|NextPara|descend|EndLine|TopPage|BotPage|replace|FindTag|GetPage|GetAttr|OneStep|LibFunc|GetDate|GetTime|GetProp|KeyDown|RunInfo|SetUndo|sizeof|SetSel|GetSel|IsFile|DlgHit|GetWCB|range|depth|xdist|tail|fail|find|exec|wait|sqrt|rdec|len|chr|odd|var|asc)(?![\\w.\\x{0590}-\\x{05ff}])(?=\\s*\\()",
      "name": "support.function.builtin.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(GetPrinterInfo|UpdateWindow|BreakHandler|FrameHandler|ClickHandler|OpenFileDlg|WindowGroup|GetTextBox|PageChange|TagVersion|GetGraphic|PageBreak|stylemask|GetBorder|SetRuler|reverse|compile|AddLead|SetProp|TextBox|graphic|GetShow|GetTbxy|global|dialog|export|insert|create|unlock|import|border|SetWCB|close|paste|print|clear|beep|show|hide|open|just|attr|save|lock|tbxy|exit|use|msg|new|run|tbx|tby|cd)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "support.function.command.tag-script"
    },
    {
      "match": "(?i)(?<![\\w.\\x{0590}-\\x{05ff}])(GetSystemMetrics|GetRegistration|GetNoteModulus|GetFileString|SetFileString|ObjectChanged|GetPasteInfo|GetStyleName|BreakPenalty|SetDlgScript|GetWindowPos|GetKeyValue|GetTagIndex|GetTagTable|GetFileName|SetDlgFocus|GetDlgFocus|FindOptions|SetDlgText|GetDlgText|ActiveText|GetVarName|ReplaceTag|SetPenalty|ActivePage|GetViewSel|StartLine|LineCount|StartPara|FindBreak|tightness|DlgEnable|GetTagDir|FillArray|CopyArray|NextLine|PrevPage|NextPage|FindPage|NumToHeb|ModalDlg|SetCheck|GetCheck|IsGlobal|rFindTag|NextPara|descend|EndLine|TopPage|BotPage|replace|FindTag|GetPage|GetAttr|OneStep|LibFunc|GetDate|GetTime|GetProp|KeyDown|RunInfo|SetUndo|sizeof|SetSel|GetSel|IsFile|DlgHit|GetWCB|range|depth|xdist|tail|fail|find|exec|wait|sqrt|rdec|len|chr|odd|var|asc)(?![\\w.\\x{0590}-\\x{05ff}])",
      "name": "support.function.builtin.tag-script"
    },
    {
      "match": "^\\s*([A-Za-z_\\x{05d0}-\\x{05ea}][\\w.\\x{05d0}-\\x{05ea}]*)(?=:(?!=))",
      "name": "entity.name.label.tag-script"
    },
    {
      "match": ":=|\\+=|-=|\\*=|/=|<=|>=|<>|[=<>+\\-*/^@]",
      "name": "keyword.operator.tag-script"
    },
    {
      "match": "\\\\.*$",
      "name": "punctuation.separator.continuation.tag-script"
    }
  ],
  "repository": {
    "comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.tag-script"
    },
    "declaration": {
      "captures": {
        "1": {
          "name": "keyword.control.tag-script"
        },
        "2": {
          "name": "keyword.control.tag-script"
        }
      },
      "match": "(?i)^\\s*(end)\\s+(func|function|if|for|while)(?![\\w.\\x{0590}-\\x{05ff}])"
    },
    "function": {
      "captures": {
        "1": {
          "name": "storage.type.function.tag-script"
        },
        "2": {
          "name": "entity.name.function.tag-script"
        }
      },
      "match": "(?i)^\\s*(func|function)\\s+([^\\s(;]+)"
    },
    "number": {
      "match": "(?i)(?<![\\w.])(\\d+:\\d+(\\.\\d+)?pc|(\\d+\\.?\\d*|\\.\\d+)(pt|pc|in|cm)?)(?![\\w])",
      "name": "constant.numeric.tag-script"
    },
    "string": {
      "begin": "\"",
      "end": "\"|(?<![\\\\\\n])$",
      "name": "string.quoted.double.tag-script",
      "patterns": [
        {
          "match": "\\\\$",
          "name": "punctuation.separator.continuation.tag-script"
        },
        {
          "match": "(?i)\\\\(x..|q[cdlr]|.)",
          "name": "constant.character.escape.tag-script"
        }
      ]
    }
  },
  "scopeName": "source.tag-script"
}
